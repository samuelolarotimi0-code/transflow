# SQLite database file (relative to project root).
DATABASE_URL="file:./db/custom.db"

# Python interpreter with openai-whisper installed.
# Windows example: LOCAL_ASR_PYTHON="C:\Python312\python.exe" or path to .venv/Scripts/python.exe
# macOS / Linux example: LOCAL_ASR_PYTHON="./.venv/bin/python"
LOCAL_ASR_PYTHON=""

# Whisper model name (options: tiny, base, small, medium, large; defaults to base)
WHISPER_MODEL="base"

# Optional: Override ffmpeg binary location if not on PATH or in project ./bin folder
# FFMPEG_BIN="./bin/ffmpeg.exe"

# Optional: Override yt-dlp binary location if not on PATH or in project ./bin folder
# YT_DLP_BIN="./bin/yt-dlp.exe"
