# ---------------------------------------------------------------
# DATABASE  (PostgreSQL for production / Fly.io)
# ---------------------------------------------------------------
# Connection pooler URL (used by Prisma at runtime via PgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/transflow?pgbouncer=true"

# Direct connection URL (used by Prisma Migrate — bypasses pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/transflow"

# ---------------------------------------------------------------
# NEXTAUTH
# ---------------------------------------------------------------
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------
# TRANSCRIPTION SERVICE
# URL the Next.js frontend uses to reach the WebSocket service.
# Locally:     ws://localhost:3003
# On Fly.io:   wss://transflow-transcribe.fly.dev
# ---------------------------------------------------------------
TRANSCRIPTION_SERVICE_URL="ws://localhost:3003"

# ---------------------------------------------------------------
# LOCAL ASR (only needed when running the transcription service)
# ---------------------------------------------------------------
# Path to the Python interpreter with openai-whisper installed.
# In Docker the venv path is baked in; override only if self-hosting.
LOCAL_ASR_PYTHON=""

# Whisper model size (tiny | base | small | medium | large)
# 'base' is a good balance of speed vs accuracy on a free VM.
WHISPER_MODEL="base"

# Optional: Override ffmpeg binary location (defaults to system ffmpeg)
# FFMPEG_BIN="/usr/bin/ffmpeg"

# Optional: Override yt-dlp binary location (defaults to system yt-dlp)
# YT_DLP_BIN="/usr/bin/yt-dlp"
