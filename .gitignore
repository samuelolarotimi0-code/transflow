# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules/
mini-services/*/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python & Virtual Environments
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage

# SQLite Runtime Database (regenerated by db:push)
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/db/*.db
prisma/db/*.db-journal
db/*.db
db/*.db-journal

# Next.js & Build Output
/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

# Large Binaries & Executables
bin/*.exe
bin/*.zip
bin/*.tar.gz
bin/*.7z
*.exe

# Media Downloads, Audio & Video Temp Files
downloads/
download/
saves/
*.wav
*.mp3
*.mp4
*.m4a
*.webm
*.ogg
*.flac
*.aac

# Environment Files
.env*
!.env.example

# Testing & Coverage
/coverage

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
dev.out.log
server.log
.zscripts/*.pid

# Operating System & IDE
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agent / AI Configuration
.claude/
.z-ai-config
/skills/
local-*
test
prompt
